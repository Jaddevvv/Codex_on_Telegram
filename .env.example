# Required: create a bot with @BotFather, then paste its token here.
TELEGRAM_BOT_TOKEN=123456789:replace_with_your_bot_token

# Required: the only Telegram chat allowed to use the bot.
ALLOWED_CHAT_ID=123456789

# Optional: Codex app-server settings.
# CODEX_BIN=/absolute/path/to/codex
# CODEX_WORKSPACE=/absolute/path/to/your/code
CODEX_DEFAULT_EFFORT=medium

# Optional: defaults to /root/codex-telegram/events.log.
# CODEX_EVENT_LOG=/absolute/path/to/events.log
