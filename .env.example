# Required: create a bot with @BotFather, then paste its token here.
TELEGRAM_BOT_TOKEN=123456789:replace_with_your_bot_token

# Required: your private Telegram chat ID (see the README's getUpdates step).
TELEGRAM_CHAT_ID=123456789

# Optional: the only directory the bot may work inside. Defaults to this repository.
# CODEX_WORKSPACE=/absolute/path/to/your/code

# Optional Codex settings.
CODEX_SANDBOX=workspace-write
# CODEX_MODEL=
# CODEX_BIN=codex
# CODEX_TIMEOUT=1800
