# Required: create a bot with @BotFather, then paste its token here.
TELEGRAM_BOT_TOKEN=123456789:replace_with_your_bot_token

# Required: the only Telegram chat allowed to use the bot.
ALLOWED_CHAT_ID=123456789

# Optional: Codex app-server settings.
# CODEX_BIN=/absolute/path/to/codex
# CODEX_WORKSPACE=/absolute/path/to/your/code
CODEX_DEFAULT_MODEL=gpt-6.2-sol
CODEX_DEFAULT_EFFORT=medium
# Existing default: full access without approval prompts.
CODEX_PERMISSION_MODE=full

# Optional: defaults to /root/codex-telegram/events.log.
# CODEX_EVENT_LOG=/absolute/path/to/events.log

# Optional: seconds to wait after the last file of a multi-file drop before
# acknowledging it (default 1.8).
# TELEGRAM_ATTACHMENT_BATCH_SECONDS=1.8
# Optional: thread -> conversation folder map used by /resume
# (default: conversation_state.json next to bot.py).
# TELEGRAM_CONVERSATION_STATE=/absolute/path/to/conversation_state.json

# Optional: Claude Code provider (/claude, or /new claude). Requires the
# `claude` CLI logged in for this user; claude_backend.py sits next to bot.py.
# CLAUDE_BIN=/root/.local/bin/claude
CLAUDE_DEFAULT_MODEL=claude-opus-5-5
CLAUDE_DEFAULT_EFFORT=medium
# Defaults to CODEX_PERMISSION_MODE; CLAUDE_WORKSPACE defaults to CODEX_WORKSPACE.
# CLAUDE_PERMISSION_MODE=full
# Seconds before an idle Claude CLI (~250 MB) is closed; resumed on the next message.
# CLAUDE_IDLE_TIMEOUT=900
# CLAUDE_TITLE_MODEL=claude-haiku-5-5
# CLAUDE_AI_TITLES=1
